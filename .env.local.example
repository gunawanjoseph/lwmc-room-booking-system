# Copy this file to `.env.local`.
# `npx convex dev` populates the next three values.
# Selects the personal development deployment for local development commands.
# Do not copy this value to Vercel.
CONVEX_DEPLOYMENT=

# Public `.convex.cloud` data endpoint used by the browser.
NEXT_PUBLIC_CONVEX_URL=

# Non-secret HTTP Actions base URL used only by the webhook display helper.
# Convex normally fills it; otherwise find it in the deployment settings.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public browser key for the Clerk development instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server-only key for the same Clerk development instance.
CLERK_SECRET_KEY=

# RoomOps' custom Clerk sign-in route.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# RoomOps' custom Clerk sign-up route.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Sign-in destination when Clerk has no return URL to preserve.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home

# Sign-up destination for the administrator registration flow.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/register

# Jotform, Google Calendar, recurrence, Clerk issuer, and Head Administrator
# values are Convex server variables. Set them with `npx convex env set`; do
# not put them here.
#
# Convex-only Calendar variables:
# GOOGLE_CALENDAR_ENABLED
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON_B64
# GOOGLE_CALENDAR_VENUE_MAP_JSON

# Gmail approval email integration. All five values are mandatory Convex
# server variables. Set them separately in development and production with
# `npx convex env set NAME` and `npx convex env --prod set NAME`; do not place
# OAuth credentials in Vercel or this file.
# APP_BASE_URL must be the application origin only, with no path/query/hash.
# APP_BASE_URL=https://your-vercel-app.vercel.app
# GMAIL_CLIENT_ID=<OAuth web client ID>
# GMAIL_CLIENT_SECRET=<OAuth web client secret>
# GMAIL_REFRESH_TOKEN=<offline refresh token for the sending mailbox>
# GMAIL_FROM_EMAIL=<authenticated mailbox or verified Send mail as alias>
# BOOKING_RECURRENCE_DEFAULT_COUNT
#
# Keep the service-account JSON and its base64 value out of this file,
# Vercel, and git. See docs/GOOGLE_CALENDAR_SETUP.md and
# docs/GMAIL_SETUP.md.

# Convex-only, single verified developer email. Full app access and all developer
# notifications are controlled by this value, never by app role assignment.
# DEVELOPER_EMAIL=developer@example.com
